<!DOCTYPE html>
<html lang="zh">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>OK</title>
        <% if (note.hasRelation("shareFavicon")) { %>
            <link rel="shortcut icon" href="api/notes/<%= note.getRelation("shareFavicon").value %>/download">
        <% } else { %>
            <link rel="shortcut icon" href="../favicon.ico">
        <% } %>
        <style>
            body {
                font-family: monospace;
            }
        </style>
        <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    </head>
    <body>
        <% switch (note.getLabelValue("categoryName")) {
            case "首页": %>

            <style>
                body {
                    height: 80vh;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    font-size: 2em;
                    text-align: center;
                }

                .subtitles {
                    display: flex;
                    justify-content: center;
                    margin-top: 20px;
                }

                .subtitles a {
                    margin: 0 10px;
                }
            </style>
            <h1>你好👋I'm oldkingOK</h1>
            <div class="subtitles">
                <a href="./blog">博客</a>
                •
                <a href="./db">知识库</a>
                •
                <a href="./fLinks">友链</a>
            </div>

            <div style="
                position: fixed;
                bottom: 0;
                left: 3%;
            ">
                <p style="font-size: 20px;text-align: left;">感谢赞助商提供服务器支持</p>
                <iframe frameborder=0
                    src="https://support.nodeget.com/page/promotion?id=160"
                    style="border-radius:8px; height: 270px;
                    transform: scale(0.7); transform-origin: top left;"></iframe>
            </div>

        <% break;
            case "博客": %>
            <style>
                body {
                    font-size: 16px;
                    text-align: center;
                }

                .root {
                    position: relative;
                    transform: translateX(-50%);
                    left: 50%;
                    margin: 10px 0;
                    max-width: 70%;
                }

                @media (max-width: 768px) {
                    .root {
                        max-width: max-content;
                    }
                }

                .child {
                    border: 2px solid black;
                    background-color: #f0f0f0;
                    text-align: left;
                    margin-bottom: 7px;
                }
                
                h2, p {
                    margin: 10px 20px 10px 20px;
                }

                a {
                    text-decoration: none;
                }


            </style>

            <div class="root">
            <center><h1 style="margin: 0;margin-bottom: 10px;">博客</h1></center>
            <% const childNotes = note.getVisibleChildNotes();
                for (const childNote of childNotes) { %>
                    <div class="child">
                        <a href="./<%= childNote.shareId %>">
                            <h2><%= childNote.title %></h2>
                        </a>
                        <% if (childNote.hasLabel("summary") && childNote.getLabelValue("summary")!=null) { %>
                            <p><%= childNote.getLabelValue("summary") %></p>
                        <% } %>
                        <p>
                        <%= childNote.getLabelValue("date").split("T")[0] %>
                        tags:
                        <% const tags = childNote.getLabelValues("tags");
                                        if (tags!=null ||tags!=undefined ||tags!=""){
                                            tags.forEach((tag)=>{ %>
                                <%= tag  %>
                        <%})} %>
                        </p>
                    </div>
                <% } %>
            </div>

        <% break;
            case "友链": %>
            <style>
                img {
                    width: 100%;
                }

                a {
                    display: block;
                    border: 2px solid black;
                    background-color: #f0f0f0;
                    margin: 5px;
                    width: 140px;
                    text-decoration: none;
                }

                .fLinks {
                    display: flex;
                    position: relative;
                    max-width: fit-content;
                    left: 50%;
                    transform: translateX(-50%);
                    text-align: center;
                    margin: 5px;
                    flex-wrap: wrap;
                }

                
            </style>
            <center><h1 style="margin: 0;margin-bottom: 10px;">友链</h1></center>
            <div class="fLinks">
                <% const fLnksDate = content.replace(/<\/?pre>/g, '').replace(/[\n]/g, "");
                    const fLinks = JSON.parse(fLnksDate); 
                    for (let key in fLinks) {%>
                    <a class="fLink" href="<%= fLinks[key]['link'] %>" target="_blank" rel="noopener">
                        <img src="<%= fLinks[key]['img'] %>" alt="<%= fLinks[key]['title'] %>">
                        <div><%= fLinks[key]['title'] %></div>
                        <div><%= fLinks[key]['des'] %></div>
                    </a>
                <% }%>
            </div>


        <% break;
            default: %>
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/default.min.css">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.css">
            <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/highlight.min.js"></script>
            <script src="//cdn.jsdelivr.net/npm/highlightjs-line-numbers.js@2.9.0/dist/highlightjs-line-numbers.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/twikoo@1.6.38/dist/twikoo.all.min.js"></script>
            <style>
                body {
                    font-size: 16px;
                    text-align: center;
                    padding: 0 20px;
                }

                .contents {
                    text-align: left;
                    border: 2px solid black;
                    background-color: #f0f0f0;
                    padding: 0 20px;
                    max-width: 70%;
                    position: relative;
                    left: 50%;
                    transform: translateX(-50%);
                }

                @media (max-width: 768px) {
                    .contents {
                        max-width: max-content;
                    }
                }

                img {
                    width: 100%;
                    height: auto;
                }

                pre {
                    border: 2px solid black;
                    white-space: pre;
                    overflow-x: scroll;
                    overflow-y: hidden;
                }

                .hljs-ln td {
                    padding-left: 10px;
                    vertical-align: top;
                }

                .hljs {
                    overflow-x: scroll;
                    -webkit-text-size-adjust: none;
                    background: #fff;
                    color: #000;
                }

                .collapsed {
                    max-height: 180px;
                }
                .code-toggle {
                    display: block;
                    box-sizing: border-box;
                    margin: 4px;
                    color: #007bff;
                    cursor: pointer;
                    font-size: 14px;
                }
            </style>

            <h1 style="align-self: center;"><%= note.title %></h1>
            <div class="contents">
                <%- content %>
                <div id="tcomment"></div>
            </div>
            <script>
                hljs.registerAliases("text-x-sh", {languageName: "shell"});
                // Handle language highlighting
                for (lang of hljs.listLanguages())
                    hljs.registerAliases("text-x-"+lang, {languageName: lang});
                others = {'x-sh': 'shell', 'text-plain': 'plaintext', 'text-x-csrc': 'c', 'text-x-trilium-auto': 'plaintext'}
                for (key in others)
                    hljs.registerAliases(key, {languageName: others[key]})

                hljs.highlightAll()
                hljs.initLineNumbersOnLoad();
            </script>
            <script>
                let pres = document.querySelectorAll('pre');
                for (let i = 0; i < pres.length; i++) {
                    const pre = pres[i];
                    if (!pre.textContent) continue;
                    const lineCount = pre.textContent.trim().split('\n').length;

                    if (lineCount > 10) {
                        pre.classList.add('collapsed');
                        const toggleTop = document.createElement('div');
                        toggleTop.className = 'code-toggle top';
                        toggleTop.textContent = '展开';

                        const toggleBottom = document.createElement('div');
                        toggleBottom.className = 'code-toggle bottom';
                        toggleBottom.textContent = '展开';

                        let lastScrollY = 0;
                        const toggleAction = (event) => {
                            const collapsed = pre.classList.toggle('collapsed');
                            const newText = collapsed ? '展开' : '收回';
                            toggleTop.textContent = newText;
                            toggleBottom.textContent = newText;
                            if (collapsed === true) {
                                if (event.target.classList.contains('bottom'))
                                    window.scrollTo(0, lastScrollY)
                            } else {
                                lastScrollY = window.scrollY;
                                console.log("lastScrollY: ", lastScrollY);
                            }
                        };

                        toggleTop.addEventListener('click', toggleAction);
                        toggleBottom.addEventListener('click', toggleAction);

                        pre.insertBefore(toggleTop, pre.firstChild);    // 插到最前
                        pre.appendChild(toggleBottom);                  // 插到最后
                    }
                }
            </script>
            <script>
                document.querySelectorAll('img').forEach(img => {
                    const viewer = new Viewer(img, { inline: false })
                });
            </script>
            <script>
                twikoo.init({
                    envId: "<%= subRoot.note.getLabelValue("envId") %>",
                    el: '#tcomment',
                })
            </script>

        <% break;} %>
        <div>
            <span>运行时间 <%= Math.ceil((new Date() - new Date(subRoot.note.getLabelValue("blogStartTime"))) / (24 * 60 * 60 * 1000)) %> 天</span>
            <span id="busuanzi_container_site_pv">| 总访问量 <span id="busuanzi_value_site_pv"></span></span>
        </div>
    </body>
</html>
